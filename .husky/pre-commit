# Python quality checks
if command -v uv &>/dev/null; then
  uv run ruff check . || {
    echo ''
    echo 'Ruff lint failed. Fix with: uv run ruff check --fix .'
    exit 1
  }
  uv run ruff format --check . || {
    echo ''
    echo 'Ruff format failed. Fix with: uv run ruff format .'
    exit 1
  }
fi
