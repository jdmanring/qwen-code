#!/usr/bin/env bash
# Mirrors the python-quality CI workflow. Run tooling/install-hooks.sh to install.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

echo "pre-commit: ruff lint..."
uv run ruff check .

echo "pre-commit: ruff format check..."
uv run ruff format --check .

if [ -f "tooling/project_standards_linter.py" ]; then
  echo "pre-commit: project standards lint..."
  uv run python3 tooling/project_standards_linter.py --strict tooling/ docs/ apps/control-plane-daemon/ packages/agent-infra/ packages/agent-memory/ scripts/
else
  echo "pre-commit: project standards lint... (skipped -- tooling not present on this branch)"
fi

# ESLint on staged TypeScript/JavaScript files only -- avoids full nx pipeline overhead.
STAGED_TS=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(ts|tsx|js|mjs)$' || true)
if [ -n "$STAGED_TS" ]; then
  echo "pre-commit: eslint (staged files)..."
  # shellcheck disable=SC2086
  pnpm exec eslint $STAGED_TS
fi

echo "pre-commit: all checks passed."
