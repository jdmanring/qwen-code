#!/usr/bin/env bash
set -euo pipefail

echo ""
echo "========================================"
echo "       MEGALONYX STATUS"
echo "========================================"
echo ""

check_service() {
    local name=$1
    local pattern=$2
    if pgrep -f "$pattern" > /dev/null; then
        echo -e "[\033[0;32m OK \033[0m] $name"
    else
        echo -e "[\033[0;31m -- \033[0m] $name"
    fi
}

check_service "Qdrant"         "qdrant"
check_service "vLLM"           "vllm"
check_service "Memory Daemon"  "memory_daemon"

echo ""
echo "--- Health Checks ---"

if curl -s http://localhost:6333/health > /dev/null; then
    echo "[OK] Qdrant API reachable"
else
    echo "[--] Qdrant API UNREACHABLE"
fi

WAL_PATH="$HOME/.local/share/megalonyx/memory/wal.jsonl"
if [ -f "$WAL_PATH" ]; then
    LINE_COUNT=$(wc -l < "$WAL_PATH")
    echo "[OK] WAL exists ($LINE_COUNT pending entries)"
else
    echo "[--] WAL empty or missing"
fi

echo ""
echo "========================================"
