# 🔐 Mega Code Environment Configuration Template
# Copy this file to ~/.qwen/.env and fill in your actual API keys.

# --- Memory & Vector Database (Qdrant) ---
# URL for the local Qdrant instance (Default: http://localhost:6333)
QDRANT_LOCAL_URL=http://localhost:6333
# URL for Qdrant Cloud (Optional: leave empty if using local)
QDRANT_CLOUD_URL=
# API Key for Qdrant Cloud (Optional)
QDRANT_API_KEY=

# --- Embedding Providers ---
# API Key for Google Gemini Embeddings
GEMINI_API_KEY=

# --- LLM Provider Keys ---
# Default key for OpenAI-compatible providers
OPENAI_API_KEY=
# Token for GitHub Models / Copilot
GITHUB_TOKEN=

# --- System Configuration ---
# Root of the Megalonyx local data directory; used by Qdrant config and launcher scripts
STACK_ROOT=~/.local/share/megalonyx
# Transport method for MCP servers (socket | stdio)
MCP_TRANSPORT=socket
# Absolute path to the project settings file
STACK_SETTINGS_PATH=~/.qwen/settings.json
# Path to the Python executable for the Qdrant MCP server
QDRANT_MCP_PYTHON=~/.local/share/megalonyx/venvs/mcp-server-qdrant/bin/python
