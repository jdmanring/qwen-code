  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "."
      ]
    },
    "memory": {
      "command": "mega-run-py",
      "args": [
        "packages/core/src/memory_bridge.py"
      ]
    },
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "$GITHUB_TOKEN"
      }
    },
    "internet-search": {
      "command": "npx",
      "args": [
        "-y",
        "tavily-mcp"
      ],
      "env": {
        "TAVILY_API_KEY": "$TAVILY_API_KEY"
      }
    },
    "code-index": {
      "command": "uvx",
      "args": [
        "code-index-mcp"
      ]
    }
  },
  "security": {
    "auth": {
      "selectedType": "gemini"
    }
  },
  "model": {
    "name": "gemma-4-31b-it",
    "maxSessionTurns": -1,
    "chatCompression": {}
  },
  "$version": 4,
  "mcp": {
    "excluded": []
  },
  "fastModel": "LongCat-2.0-Preview"
}
