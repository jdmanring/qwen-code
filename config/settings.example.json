{
  "memory": {
    "enableManagedAutoMemory": false
  },
  "tools": {
    "approvalMode": "default"
  },
  "general": {
    "language": "en",
    "outputLanguage": "English"
  },
  "ui": {
    "accessibility": {
      "enableLoadingPhrases": false
    }
  },
  "logging": {
    "log_level": "DEBUG",
    "log_path": "~/.qwen/logs/system.log",
    "enable_trace": true
  },
  "env": {
    "VLLM_API_KEY": "$VLLM_API_KEY",
    "QDRANT_LOCAL_URL": "$QDRANT_LOCAL_URL",
    "QDRANT_CLOUD_URL": "$QDRANT_CLOUD_URL",
    "QDRANT_API_KEY": "$QDRANT_API_KEY",
    "TAVILY_API_KEY": "$TAVILY_API_KEY",
    "OPENAI_API_KEY": "$OPENAI_API_KEY",
    "GITHUB_TOKEN": "$GITHUB_TOKEN",
    "GEMINI_API_KEY": "$GEMINI_API_KEY",
    "GROQ_API_KEY": "$GROQ_API_KEY",
    "OPENROUTER_API_KEY": "$OPENROUTER_API_KEY",
    "NVIDIA_API_KEY": "$NVIDIA_API_KEY",
    "QUODER_API_KEY": "$QUODER_API_KEY",
    "POLLINATIONS_API_KEY": "$POLLINATIONS_API_KEY",
    "LONGCAT_API_KEY": "$LONGCAT_API_KEY",
    "CEREBRUS_API_KEY": "$CEREBRUS_API_KEY",
    "MISTRAL_API_KEY": "$MISTRAL_API_KEY"
  },
  "modelProviders": {
    "openai": [
      {
        "id": "LongCat-Flash-Lite",
        "name": "LongCat * Flash Lite",
        "description": "Ultra-high throughput MoE model optimized for low-cost, high-volume agent workloads. Best used for bulk generation, lightweight reasoning, and fallback execution in distributed systems. Not suitable for critical reasoning chains requiring strict reliability or deterministic tool execution.",
        "envKey": "LONGCAT_API_KEY",
        "provider": "LongCat",
        "baseUrl": "https://api.longcat.chat/openai/v1",
        "capabilities": {
          "reasoning": true,
          "coding": true,
          "toolCalling": true
        },
        "generationConfig": {
          "timeout": 600000,
          "contextWindowSize": 256000,
          "samplingParams": {
            "temperature": 0.2,
            "top_p": 0.95,
            "max_tokens": 4096
          }
        },
        "stream": false
      },
      {
        "id": "LongCat-Flash-Chat",
        "name": "LongCat * Flash Chat",
        "description": "General-purpose large MoE chat model with strong coding, reasoning, and agent-style tool usage. Recommended default LongCat model for balanced performance and throughput. Suitable for production-adjacent workloads but should be paired with fallback routing due to serverless variability.",
        "envKey": "LONGCAT_API_KEY",
        "provider": "LongCat",
        "baseUrl": "https://api.longcat.chat/openai/v1",
        "capabilities": {
          "reasoning": true,
          "coding": true,
          "toolCalling": true
        },
        "generationConfig": {
